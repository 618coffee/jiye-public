# ─────────────────────────────────────────────────────────────
# 小本本 · 本地开发配置
# 复制成 backend/.env 并填入你的 key/secret 即可。
#   cp backend/.env.example backend/.env
# 不填的项会自动落 Mock，UI 与流程不受影响。
# 改完重启 backend 生效（./scripts/dev.sh）。
# ─────────────────────────────────────────────────────────────


# ── LLM & Embedding：三选一（优先级：Azure > Qwen > Mock）────

# 选项 A · Azure AI Foundry / Azure OpenAI（OpenAI 兼容端点）
# Endpoint 形如：
#   https://<resource>.openai.azure.com           （Azure OpenAI）
#   https://<resource>.services.ai.azure.com      （Azure AI Foundry）
#   https://<resource>.cognitiveservices.azure.com（Cognitive Services）
# 末尾有没有斜杠都行，不要带 /openai 路径段。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Chat 模型部署名（注意：填的是 deployment 名字，不是模型名本身）
# 也支持 model-router 部署（会自动处理不支持 response_format 的情况）
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# Embedding 模型部署名（推荐 text-embedding-3-small / 1536 维）
# 没有 quota / 没部署时留空，会降级到本地 Mock embedding（向量检索质量差，但 BM25 仍真实）
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# API 版本，一般不用改
AZURE_OPENAI_API_VERSION=2024-10-21

# 选项 B · 阿里 Dashscope (Qwen) — Azure 不填时启用
QWEN_API_KEY=


# ── POI 鲜活度验证 ────────────────────────────────────────────

# 高德开放平台 · 国内 POI 验证（key 申请：https://lbs.amap.com/dev/key）
AMAP_API_KEY=

# Google Places API · 海外 POI 验证
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=


# ── 行为开关 ──────────────────────────────────────────────────

# auto = 没填 key 时走 Mock；true = 强制 Mock；false = 强制真实调用
USE_MOCK=auto

# 数据目录（相对 backend/，默认与项目同级 data/）
DATA_DIR=../data
